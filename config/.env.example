# =============================================================================
# AI Plugin Environment Variables
# =============================================================================
#
# This file contains all environment variables needed for the AI plugin.
# Copy this file to .env and fill in your actual values.

# -----------------------------------------------------------------------------
# Default Provider Configuration
# -----------------------------------------------------------------------------
# Specify which AI provider to use by default
AI_DEFAULT_PROVIDER=openrouter

# -----------------------------------------------------------------------------
# OpenRouter Provider Configuration
# -----------------------------------------------------------------------------
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# API endpoint (usually no need to change)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Request timeout in seconds
OPENROUTER_TIMEOUT=120

# Model identifiers - see https://openrouter.ai/docs for available models
OPENROUTER_TEXT_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_EMBEDDINGS_MODEL=
# Embedding vector dimensions (must match the model's output; 1536 is the
# plugin default, e.g. 768 for nemotron-1b / gemini-embedding-001)
OPENROUTER_EMBEDDINGS_DIMENSIONS=1536
OPENROUTER_IMAGE_MODEL=
OPENROUTER_AUDIO_MODEL=
OPENROUTER_TRANSCRIPTION_MODEL=

# -----------------------------------------------------------------------------
# Broadcasting Configuration
# -----------------------------------------------------------------------------
# Enable real-time event broadcasting via Broadcasting plugin
AI_BROADCASTING_ENABLED=false
AI_BROADCASTING_CHANNEL=ai

# -----------------------------------------------------------------------------
# Queue Configuration
# -----------------------------------------------------------------------------
# Enable async job processing via Queue plugin
AI_QUEUE_ENABLED=false
AI_QUEUE_CONNECTION=default

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------
# Where to store conversations and related data
AI_STORAGE_DRIVER=database
AI_STORAGE_TABLE=ai_conversations
