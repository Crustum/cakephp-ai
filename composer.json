{
    "name": "crustum/cakephp-ai",
    "description": "AI plugin for CakePHP applications",
    "type": "cakephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Evgeny Tomenko",
            "homepage": "https://github.com/skie"
        }
    ],
    "require": {
        "php": ">=8.2",
        "aws/aws-sdk-php": "^3.393",
        "cakephp/cakephp": "^4.5",
        "cakephp/queue": "^1.0",
        "crustum/broadcasting": "^0.0.1",
        "crustum/plugin-manifest": "^0.0.1",
        "guzzlehttp/guzzle": "^7.8",
        "crustum/json-schema": "^1.0",
        "opis/closure": "^4.5",
        "laravel/serializable-closure": "^2.0",
        "league/flysystem": "^3.29",
        "league/flysystem-local": "^3.29",
        "psr/simple-cache": "^2.0",
        "symfony/polyfill-php84": "^1.31"
    },
    "require-dev": {
        "cakephp/bake": "^2.0",
        "phpunit/phpunit": "^9.0",
        "pestphp/pest": "^1.0|^2.0",
        "cakephp/cakephp-codesniffer": "^4.0",
        "phpstan/phpstan": "^1.0",
        "mockery/mockery": "^1.6",
        "doctrine/instantiator": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "Crustum\\Ai\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "TestApp\\": "tests/TestApp/",
            "Crustum\\Ai\\Test\\": "tests/"
        },
        "files": [
            "tests/helpers.php",
            "tests/Support/Http/functions.php",
            "tests/Support/Http/fake_responses.php"
        ]
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@stan"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/ tests/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/ tests/",
        "test": "pest",
        "test:unit": "pest --testsuite=Unit",
        "test:integration": "pest --testsuite=Integration",
        "test:coverage": "pest --coverage",
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan": "phpstan analyse src/",
        "stan-baseline": "phpstan analyse --generate-baseline",
        "structarmed": "vendor/bin/structarmed analyze src"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        },
        "platform-check": false,
        "audit": {
            "block-insecure": false
        }
    }
}
