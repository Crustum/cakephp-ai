parameters:
    level: 5
    paths:
        - src
    bootstrapFiles:
        - tests/bootstrap.php
    tmpDir: build/phpstan
    excludePaths:
        - src/Gateway/Trait/ComposesSchemaInstructionsTrait.php
        - src/Providers/Trait/HasRerankingGatewayTrait.php
        - src/Providers/Trait/ReranksTrait.php
        - src/Trait/RemembersConversationsTrait.php
        - src/Trait/InteractsWithApprovalsTrait.php
    ignoreErrors:
        -
            identifier: new.static
            path: src/Trait/PromptableTrait.php
            reportUnmatched: false

services:
